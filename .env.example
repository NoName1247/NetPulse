# Mode: development | production
ENVIRONMENT=production

# PostgreSQL 16
POSTGRES_DB=netpulse
POSTGRES_USER=netpulse
POSTGRES_PASSWORD=change_me_postgres_password
DATABASE_URL=postgresql://netpulse:change_me_postgres_password@postgres:5432/netpulse

# Probe Node HMAC Secrets (supports rotation: "new_key,old_key")
NODE_1_SECRET=change_me_my_node_secret
NODE_2_SECRET=change_me_eu_node_secret
NODE_SECRETS_JSON={"1":"change_me_my_node_secret","2":"change_me_eu_node_secret"}

# MaxMind GeoLite2 databases
GEOLITE2_ASN_PATH=/data/geoip/GeoLite2-ASN.mmdb
GEOLITE2_CITY_PATH=/data/geoip/GeoLite2-City.mmdb

# Security Perimeter (Cloudflare Turnstile + Origin Secret)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=
ORIGIN_SECRET=
CORS_ALLOWED_ORIGINS=https://referencekk.online,http://127.0.0.1:8081

# Caddy production domain (used only in infra/docker-compose.central.yml)
API_DOMAIN=api.netpulse.my

# Observability & Telegram Alerts (optional)
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
