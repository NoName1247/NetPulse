FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY pyproject.toml ./
COPY shared_proto.py ./
COPY central ./central

RUN mkdir -p probe && \
    pip install --no-cache-dir . && \
    rm -rf probe && \
    groupadd -r netpulse && useradd -r -g netpulse netpulse && \
    mkdir -p /run/app /data/geoip && \
    chown -R netpulse:netpulse /app /run/app

USER netpulse

# 1 воркер Uvicorn на uvloop через Unix Domain Socket (0 Split-Brain, 0 Valkey, 0 raw IP в access-логах)
CMD ["sh", "-c", "umask 000 && exec uvicorn central.main:app --uds /run/app/uvicorn.sock --workers 1 --loop uvloop --http httptools --no-access-log"]