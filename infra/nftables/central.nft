#!/usr/sbin/nft -f
# Central VPS Firewall: порт 443 открыт строго для официальных подсетей Cloudflare.
# Рекомендуется периодически сверять диапазоны с https://www.cloudflare.com/ips-v4 и /ips-v6.

flush ruleset

table inet filter {
    set cloudflare_ipv4 {
        type ipv4_addr
        flags interval
        elements = {
            173.245.48.0/20,
            103.21.244.0/22,
            103.22.200.0/22,
            103.31.4.0/22,
            141.101.64.0/18,
            108.162.192.0/18,
            190.93.240.0/20,
            188.114.96.0/20,
            197.234.240.0/22,
            198.41.128.0/17,
            162.158.0.0/15,
            104.16.0.0/13,
            104.24.0.0/14,
            172.64.0.0/13,
            131.0.72.0/22
        }
    }

    set cloudflare_ipv6 {
        type ipv6_addr
        flags interval
        elements = {
            2400:cb00::/32,
            2606:4700::/32,
            2803:f800::/32,
            2405:b500::/32,
            2405:8100::/32,
            2a06:98c0::/29,
            2c0f:f248::/32
        }
    }

    chain input {
        type filter hook input priority 0; policy drop;

        iif "lo" accept
        ct state established,related accept
        ct state invalid drop

        # ICMP базовый (ping / path MTU)
        ip protocol icmp icmp type { echo-request, destination-unreachable, time-exceeded } accept
        ip6 nexthdr icmpv6 accept

        # SSH (Ed25519 keys only)
        tcp dport 22 accept

        # HTTPS / HTTP3 (443) строго с IP Cloudflare
        ip saddr @cloudflare_ipv4 tcp dport { 80, 443 } accept
        ip saddr @cloudflare_ipv4 udp dport 443 accept
        ip6 saddr @cloudflare_ipv6 tcp dport { 80, 443 } accept
        ip6 saddr @cloudflare_ipv6 udp dport 443 accept
    }

    chain forward {
        type filter hook forward priority 0; policy drop;
    }

    chain output {
        type filter hook output priority 0; policy accept;
    }
}